{
  "name": "bff-service",
  "version": "0.1.0",
  "scripts": {
    "build": "nest build",
    "build2": "node esbuild.config.js",
    "start": "nest start",
    "start2": "npm run build && node dist/index.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "docker:build": "docker build --tag mcnic/bff-api:latest .",
    "docker:push": "docker push mcnic/bff-api:latest",
    "docker:start": "docker run -it --rm -p 4000:4000 mcnic/bff-api",
    "docker:test": "docker run -it --rm -p 4000:4000 mcnic/bff-api /bin/sh",
    "docker:up": "docker compose --env-file .env up --detach",
    "docker:down": "docker compose down",
    "eb:init": "eb init mcnic-bff-api",
    "eb:create": "eb create prod --cname mcnic-bff-api --single",
    "eb:setenv": "env-cmd -x -f .env eb setenv DATABASE_URL=\\${DATABASE_URL} SERVER_PORT=\\$SERVER_PORT PG_USER=\\$PG_USER PG_PASSWORD=\\$PG_PASSWORD PG_HOST=\\$PG_HOST",
    "eb:deploy": "eb deploy prod",
    "eb:terminate": "eb terminate mcnic-bff-api",
    "eb:logs": "eb logs | grep ERROR"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.4",
    "@nestjs/schematics": "^10.1.3",
    "@nestjs/testing": "^10.4.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "20.14.2",
    "@types/supertest": "^6.0.2",
    "env-cmd": "^10.1.0",
    "esbuild": "^0.23.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.4.5"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-express": "^10.4.1",
    "axios": "^1.7.4",
    "cache-manager": "^5.7.6",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  }
}
